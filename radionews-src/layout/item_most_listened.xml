<?xml version="1.0" encoding="utf-8"?>
<!--
    item_most_listened.xml
    ───────────────────────────────────────────────────────
    • Kenar boşlukları kaldırıldı (marginHorizontal / marginVertical = 0)
    • Köşe yuvarlaklığı kaldırıldı (cardCornerRadius = 0)
    • Gölge kaldırıldı (cardElevation = 0)
    • Satır altına ince, belirsiz bir ayırıcı çizgi eklendi
    • item_station.xml ile aynı stil
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/accent_dim"
    app:strokeWidth="0dp">

    <!-- Dikey kapsayıcı: içerik + altta ayırıcı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Asıl satır içeriği -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Sıra rozeti -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvRank"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#212749"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Logo / Avatar -->
            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="13dp">

                <!-- Avatar (avatar önce, logo üstünde) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvAvatar"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    app:cardCornerRadius="27dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/tvAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Logo (sonra geldiği için z-order'da üstte) -->
                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:contentDescription="Logo"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Bilgi -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/playingDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_playing_dot"
                        android:visibility="invisible" />

                    <TextView
                        android:id="@+id/tvStationName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvCountry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvPlayCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/accent"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Favori -->
            <ImageButton
                android:id="@+id/ivFavorite"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Favori"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/favorite_empty" />

        </LinearLayout>

        <!-- ── Alt ayırıcı çizgi (çok belirgin değil) ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="#333333" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>