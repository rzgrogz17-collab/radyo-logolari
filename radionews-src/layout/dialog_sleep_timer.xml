<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/sleep_timer"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTimerHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingTop="4dp"
        android:text="@string/timer_lock_hint"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <com.globalradio.livetuneinogzapp.utils.TimerRingView
        android:id="@+id/timerRing"
        android:layout_width="168dp"
        android:layout_height="168dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupDurations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp">

        <ImageButton
            android:id="@+id/btnCustomMinus"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_player_round_btn"
            android:contentDescription="@string/timer_minus"
            android:src="@drawable/ic_skip_previous"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvCustomMinutes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="15 min"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCustomPlus"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_player_round_btn"
            android:contentDescription="@string/timer_plus"
            android:src="@drawable/ic_skip_next"
            app:tint="@color/white" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartCustom"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:text="@string/timer_start"
        android:textAllCaps="false"
        app:backgroundTint="#E91E63"
        app:cornerRadius="14dp" />

    <LinearLayout
        android:id="@+id/extendRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMinus5"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:text="@string/timer_minus_5"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:strokeColor="@color/badge_gold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlus5"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:text="@string/timer_plus_5"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:strokeColor="@color/badge_gold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlus15"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:text="@string/timer_plus_15"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:strokeColor="@color/badge_gold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchFade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/timer_fade"
            android:textColor="@color/white"
            app:thumbTint="#E91E63" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchMute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/timer_mute_instead"
            android:textColor="@color/white"
            app:thumbTint="#E91E63" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelTimer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:text="@string/timer_cancel"
        android:textColor="@color/accent"
        android:visibility="gone"
        app:backgroundTint="@color/bg_card"
        app:cornerRadius="14dp" />

</LinearLayout>
