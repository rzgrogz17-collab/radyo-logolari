<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Fragment Konteyneri -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_weight="1" />

    <!--
        Mini Player:
        Neon kenarlık View (sadece çerçeve, şeffaf içi) + üstüne asıl kart.
        FrameLayout sayesinde ikisi aynı alanda üst üste gelir.
        Neon View tam boyutta, kart 2dp içeride → kenarlar görünür.
    -->
    <FrameLayout
        android:id="@+id/miniPlayerWrapper"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone">

        <!-- Neon çerçeve (şeffaf iç, sadece stroke) -->
        <View
            android:id="@+id/neonBorder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_neon_border" />

        <!-- Asıl içerik kartı — 2dp margin ile neon çerçeveyi açıkta bırakır -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/miniPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            app:cardBackgroundColor="#0d0d0e"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Ana satır -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <!-- Logo -->
                    <ImageView
                        android:id="@+id/ivMiniLogo"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:contentDescription="Logo"
                        android:src="@drawable/baseline_audiotrack_24" />

                    <!-- İsim + durum -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMiniStationName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="marquee"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:singleLine="true"
                            android:text="@string/app_name"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ProgressBar
                                android:id="@+id/miniBuffering"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginEnd="4dp"
                                android:indeterminateTint="#ca005e"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tvMiniStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/status_live"
                                android:textColor="#ca005e"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Sleep Timer -->
                    <ImageButton
                        android:id="@+id/btnMiniSleepTimer"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Sleep timer"
                        android:src="@drawable/ic_sleep_timer"
                        app:tint="#FFFCFC" />

                    <!-- Oynat/Duraklat -->
                    <ImageButton
                        android:id="@+id/btnMiniPlayPause"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Play/Pause"
                        android:src="@drawable/ic_pause_circle" />

                    <!-- Ekolayzer -->
                    <ImageButton
                        android:id="@+id/btnMiniEqualizer"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Equalizer"
                        android:src="@drawable/ic_equalizer"
                        app:tint="#8899AA" />

                </LinearLayout>

                <!-- Sleep timer geri sayım -->
                <LinearLayout
                    android:id="@+id/sleepTimerBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_dot" />

                    <TextView
                        android:id="@+id/tvSleepTimerRemaining"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/timer_countdown_red"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <!-- Banner Reklam -->
    <FrameLayout
        android:id="@+id/bannerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:minHeight="50dp" />

</LinearLayout>