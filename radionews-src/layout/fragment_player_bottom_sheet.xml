<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Blur arka plan -->
    <ImageView
        android:id="@+id/ivBlurBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Background"
        android:scaleType="centerCrop" />

    <!-- Koyu overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_player_overlay" />

    <!-- İçerik: logo ortada kare büyür; rewind/save ve banner sabit -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- ── ÜST BAR ── -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:src="@drawable/ic_arrow_down"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/now_playing"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Share"
                android:src="@drawable/ic_share"
                app:tint="#ffffff" />

        </RelativeLayout>

        <!-- Logo aşağı doğru büyür; rewind/save ve banner sabit kalır. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Kare logo: ekranın ortasında, dört yönde mümkün olduğunca büyük -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="2dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/logoPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

            </FrameLayout>

            <!-- ── İSTASYON BİLGİSİ ── -->
            <TextView
                android:id="@+id/tvStationName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="8dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Ülke pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_quality_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/tvCountry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#AABBCC"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Tags + sıra -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#556677"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  ·  "
                    android:textColor="#556677"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvStationIndex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#556677"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Canlı / duraklatıldı — tek satır, banner'a taşmaz -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/equalizerView"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="invisible">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="12dp"
                        android:layout_marginHorizontal="1dp"
                        android:background="@color/accent" />

                    <View
                        android:layout_width="3dp"
                        android:layout_height="8dp"
                        android:layout_marginHorizontal="1dp"
                        android:background="@color/accent" />

                    <View
                        android:layout_width="3dp"
                        android:layout_height="14dp"
                        android:layout_marginHorizontal="1dp"
                        android:background="@color/accent" />

                    <View
                        android:layout_width="3dp"
                        android:layout_height="6dp"
                        android:layout_marginHorizontal="1dp"
                        android:background="@color/accent" />
                </LinearLayout>

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_live_dot" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/status_live"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Logo rewind/kaydet paneline yapışmasın -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- ── İLERLEME / GERİ SAR / KAYDET ── -->
        <LinearLayout
            android:id="@+id/playbackScrubber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_player_scrubber"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnRewind"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_player_round_btn"
                    android:contentDescription="@string/rewind_15"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_rewind_15"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rewind_15_short"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:id="@+id/tvElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:fontFamily="sans-serif-medium"
                        android:text="0:00"
                        android:textColor="#F2FFFFFF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/live_badge"
                        android:textColor="#E01B3B"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <SeekBar
                    android:id="@+id/seekBarProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:max="1000"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progress="0"
                    android:progressBackgroundTint="#55FFFFFF"
                    android:progressTint="#E01B3B"
                    android:splitTrack="false"
                    android:thumb="@drawable/bg_progress_thumb" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnSave"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_player_round_btn"
                    android:contentDescription="@string/save_recording"
                    android:padding="9dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_record"
                    app:tint="#E01B3B" />

                <TextView
                    android:id="@+id/tvSaveLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/save_short"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── SES SLIDER ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Vol low"
                android:src="@drawable/ic_volume_low"
                app:tint="#ffffff" />

            <SeekBar
                android:id="@+id/seekBarVolume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="70"
                android:progressBackgroundTint="#334455"
                android:progressTint="#FFFFFF"
                android:thumb="@drawable/bg_volume_thumb" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Vol high"
                android:src="@drawable/ic_volume_high"
                app:tint="#ffffff" />

        </LinearLayout>

        <!-- ── ANA KONTROLLER ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/favorite"
                android:src="@drawable/ic_favorite_border"
                app:tint="#2C2C34" />

            <ImageButton
                android:id="@+id/btnPrevious"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_control_button"
                android:contentDescription="Previous"
                android:src="@drawable/ic_skip_previous"
                app:tint="#FFFFFF" />

            <FrameLayout
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginHorizontal="8dp">

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_play_button"
                    android:contentDescription="Play/Pause"
                    android:src="@drawable/ic_play_circle_large" />

                <ProgressBar
                    android:id="@+id/progressBuffering"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:indeterminateTint="@color/accent"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_control_button"
                android:contentDescription="Next"
                android:src="@drawable/ic_skip_next"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnEqualizerPlayer"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Equalizer"
                android:src="@drawable/ic_equalizer"
                app:tint="#ffffff" />

        </LinearLayout>

        <!-- ── BANNER REKLAM — sabit 50dp, nav bar üstünde tam görünür ── -->
        <FrameLayout
            android:id="@+id/playerBannerContainer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:minHeight="56dp"
            android:visibility="invisible" />

    </LinearLayout>

</FrameLayout>