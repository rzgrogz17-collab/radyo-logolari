<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <!-- Altta kalan geniş, yumuşak ambiyans parlaması -->
    <View
        android:id="@+id/ambientGlow"
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_glow_circle" />

    <!-- İçerik: logo + yazılar + noktalar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo grubu: nefes alır gibi birlikte büyüyüp küçülen parlama + logo çerçevesi -->
        <FrameLayout
            android:id="@+id/logoWrapper"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:alpha="1">

            <!-- Logonun hemen arkasındaki odaklı parlama -->
            <View
                android:id="@+id/logoGlow"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_logo_glow" />

            <!-- Logo çerçevesi: hafif parlayan yuvarlak arka plan -->
            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_logo_circle">

                <ImageView
                    android:layout_width="180dp"
                    android:layout_height="170dp"
                    android:layout_gravity="center"
                    android:src="@drawable/radiosphere"
                    android:contentDescription="@string/app_name" />
            </FrameLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:alpha="0"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvSplashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0"
            android:text="@string/splash_subtitle"
            android:textColor="#E6EBF0"
            android:textSize="13sp"
            android:letterSpacing="0.12" />

        <!-- İnce ayırıcı çizgi -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="0dp"
            android:background="#334A6C"
            android:alpha="0.8" />

        <!-- Loading noktaları -->
        <LinearLayout
            android:id="@+id/loadingDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:alpha="0"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_dot"
                android:alpha="1.0" />

            <View
                android:id="@+id/dot2"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_dot"
                android:alpha="0.5" />

            <View
                android:id="@+id/dot3"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_dot"
                android:alpha="0.25" />

        </LinearLayout>

    </LinearLayout>

    <!-- Alt köşe versiyon yazısı -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:text=""
        android:textColor="#FDFCF8"
        android:textSize="11sp"
        android:letterSpacing="0.1" />

</FrameLayout>
