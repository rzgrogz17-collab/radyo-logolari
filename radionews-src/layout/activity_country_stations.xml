<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_country_stations.xml
    ───────────────────────────────────────────────────────
    • RecyclerView'daki paddingVertical="4dp" kaldırıldı
      (listenin tam üstten başlaması ve ilk satırın üstünde
       boşluk olmaması için)
    • Diğer yerler aynen korundu
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_surface"
        app:navigationIconTint="@color/text_primary"
        app:subtitleTextColor="@color/text_secondary"
        app:titleTextColor="@color/text_primary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCountryStations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <ProgressBar
            android:id="@+id/progressCountry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEmptyCountryStations"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/empty_stations"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Mini Player (MainActivity ile birebir aynı) -->
    <FrameLayout
        android:id="@+id/miniPlayerWrapper"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone">

        <View
            android:id="@+id/neonBorder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_neon_border" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/miniPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            app:cardBackgroundColor="#0d0d0e"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Ana satır -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/ivMiniLogo"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:contentDescription="Logo"
                        android:src="@drawable/baseline_audiotrack_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMiniStationName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="marquee"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:singleLine="true"
                            android:text="@string/app_name"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ProgressBar
                                android:id="@+id/miniBuffering"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginEnd="4dp"
                                android:indeterminateTint="#00E99E"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tvMiniStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/status_live"
                                android:textColor="#00E99E"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Sleep Timer -->
                    <ImageButton
                        android:id="@+id/btnMiniSleepTimer"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Sleep timer"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_mini_sleep_timer"
                        app:tint="#FFFFFF" />

                    <!-- Oynat/Duraklat -->
                    <ImageButton
                        android:id="@+id/btnMiniPlayPause"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Play/Pause"
                        android:src="@drawable/ic_pause_circle" />

                    <!-- Ekolayzer -->
                    <ImageButton
                        android:id="@+id/btnMiniEqualizer"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Equalizer"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_mini_equalizer"
                        app:tint="#FFFFFF" />

                </LinearLayout>

                <!-- Sleep timer geri sayım -->
                <LinearLayout
                    android:id="@+id/sleepTimerBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_dot" />

                    <TextView
                        android:id="@+id/tvSleepTimerRemaining"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/timer_countdown_red"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <!-- Banner -->
    <FrameLayout
        android:id="@+id/bannerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:minHeight="50dp" />

</LinearLayout>