<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RadyoApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_window_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.RadyoApp.SplashContent</item>
        <item name="android:windowSplashScreenBackground">@color/splash_window_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_window_bg</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/splash_window_bg</item>
        <item name="android:navigationBarColor">@color/splash_window_bg</item>
    </style>
</resources>
