<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#66FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:centerColor="#6E849C"
                        android:endColor="#3E5468"
                        android:startColor="#E8F2FA"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="#B3FFFFFF" />
                </shape>
            </item>
            <item
                android:width="74%"
                android:height="40%"
                android:gravity="top|center_horizontal"
                android:top="7%">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:endColor="#00FFFFFF"
                        android:startColor="#D9FFFFFF"
                        android:type="linear" />
                </shape>
            </item>
            <item
                android:width="42%"
                android:height="16%"
                android:bottom="9%"
                android:gravity="bottom|center_horizontal">
                <shape android:shape="oval">
                    <solid android:color="#A6FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
