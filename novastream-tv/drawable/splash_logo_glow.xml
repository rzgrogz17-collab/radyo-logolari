<?xml version="1.0" encoding="utf-8"?>
<!--
    res/drawable/splash_logo_glow.xml
    Logonun arkasında yumuşakça sönümlenen (şeffaflığa doğru) dairesel
    bir parıltı. SplashActivity içinde nabız (pulse) animasyonuyla
    büyütülüp küçültülerek "havalı" bir giriş hissi yaratır.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="110dp"
        android:startColor="@color/splash_glow"
        android:endColor="#00355C8A" />
</shape>
